# Panel settings. Copy to panel.env (./init.sh does this) and edit. Database and Redis
# connection settings are set in compose.yml; their passwords are generated into .env.

# The public URL of the panel, as users reach it through your reverse proxy.
APP_URL=https://panel.example.com
APP_TIMEZONE=UTC
APP_SERVICE_AUTHOR=noreply@example.com

# The reverse proxy's address as the panel sees it, so client IPs and https are detected
# correctly. With the proxy on the same host this is the frontend network's gateway; the
# README shows how to find it. Use a comma-separated list for several proxies.
# TRUSTED_PROXIES=172.30.0.1

HASHIDS_LENGTH=8

MAIL_FROM=noreply@example.com
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
